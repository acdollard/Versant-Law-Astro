---
import Layout from "../layout.astro";
---

<Layout>
  <main>
    <section class="page-hero" aria-labelledby="about-title">
      <div class="page-hero-copy">
        <h1 id="about-title">About the Founder</h1>
      </div>
    </section>

    <section class="about">
      <div class="about-layout">
        <figure class="portrait">
          <img
            src="/founder.png"
            alt="Alexander Hamilton, founder of Versant Law"
            width="800"
            height="800"
          />
          <figcaption>Alexander Hamilton, Founder</figcaption>
        </figure>
        <div class="about-card">
          <div class="about-copy">
            <p>
              Alexander Hamilton is a San Francisco transactional business and
              commercial real estate attorney whose practice spans
              acquisitions, leasing, construction, financing, and business
              formation. Before becoming a lawyer, he was a Certified Public
              Accountant with Ernst &amp; Whinney, which informs his practical
              approach to deal structuring and financial analysis.
            </p>
            <p>
              He is the author of Miller and Starr California Real Estate
              Forms (Thomson Reuters), a seven-volume guide to drafting and
              negotiating commercial real estate and construction contracts.
              He also contributes to the Lease Negotiation Handbook and has
              spoken to groups including the State Bar of California, the
              American College of Mortgage Attorneys, and the Building Owners
              and Managers Association. He founded the Commercial Real Estate
              Professionals Network and served on San Francisco’s Existing
              Building Efficiency Task Force.
            </p>
            <p>
              Mr. Hamilton is admitted to practice in California and before
              the U.S. District Court for the Northern District of California.
              He earned his J.D., cum laude, from the University of Houston
              Law Center and his B.B.A. in Accounting, cum laude, from the
              University of Texas at Austin.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="page-band" aria-labelledby="approach-title">
      <div class="section-heading">
        <h2 id="approach-title" class="ruled-title">How We Work</h2>
        <p>
          Counsel built for owners, investors, and project teams who need a
          clear path through the paperwork.
        </p>
      </div>
      <div class="value-grid">
        <article class="value-card">
          <span class="value-index">01</span>
          <h2>Practical first</h2>
          <p>
            Advice is aimed at the decision in front of you: the loan, the
            lease, the entity, or the closing. The work is structured so you
            can act on it.
          </p>
        </article>
        <article class="value-card">
          <span class="value-index">02</span>
          <h2>Outside the box</h2>
          <p>
            When a form contract or a standard structure does not fit the
            deal, we look for an arrangement that still protects the people
            signing it.
          </p>
        </article>
        <article class="value-card">
          <span class="value-index">03</span>
          <h2>Bay Area focus</h2>
          <p>
            The practice serves business owners and real estate firms across
            the San Francisco Bay Area, from acquisition through construction
            and leasing.
          </p>
        </article>
      </div>
    </section>

    <section class="cta-band">
      <svg class="grain" aria-hidden="true">
        <rect width="100%" height="100%" filter="url(#grain)" />
      </svg>
      <div class="cta-band-inner">
        <h2>Tell us what you are working on</h2>
        <p>
          A short call is enough to see whether we are the right counsel for
          the matter.
        </p>
        <a class="button" href="/contact">
          Schedule a Consultation
          <img src="/arrow-right.svg" alt="" width="14" height="14" />
        </a>
      </div>
    </section>
  </main>
</Layout>